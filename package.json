{
  "name": "kumo-browser-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A modular browser agent playground. DOM now, Vision and Hybrid later.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-browser-driver.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npm run build && node scripts/dev-server.mjs",
    "test:e2e": "npm run build && node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "dev:llm": "npm run build && node --env-file=.env.local scripts/dev-server.mjs",
    "eval:baseline": "npm run build && node scripts/eval-browser-agent.mjs --mode=baseline",
    "eval:llm": "npm run build && node --env-file=.env.local scripts/eval-browser-agent.mjs --mode=llm"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "playwright": "^1.57.0"
  }
}
