{
  "name": "kumo-browser-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modular browser agent playground. DOM now, Vision and Hybrid later.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npm run build && node scripts/dev-server.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
